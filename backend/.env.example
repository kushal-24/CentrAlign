# Keep your existing working MongoDB URI in .env. Never commit credentials.
MONGODB_URI=mongodb://127.0.0.1:27017
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=groq
GROQ_API_KEY=
# 120b follows the structured-output schemas reliably; the 20b model does not.
GROQ_MODEL=openai/gpt-oss-120b
# Shared cap on model requests per minute (keeps free-tier limits safe).
LLM_REQUESTS_PER_MINUTE=4
SITE_URL=http://localhost:4000
SITE_PORT=4000
AGENT_PORT=5000
STUDENT_EMAIL=student@example.com
MAX_STEPS=25
HEADLESS=false
