{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "format": "prettier --write \"{src,scripts,tests,evals}/**/*.{js,json}\" package.json .prettierrc.json README.md",
    "format:check": "prettier --check \"{src,scripts,tests,evals}/**/*.{js,json}\" package.json .prettierrc.json README.md",
    "test": "node --test tests/*.test.js",
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "start:site": "node src/site/server.js",
    "start:agent": "node src/agent/index.js",
    "dev:agent": "nodemon src/agent/index.js",
    "check:config": "node scripts/check-config.js",
    "seed": "node src/site/seed/seed.js",
    "verify:phase2": "node scripts/verify-phase2.js",
    "smoke": "PLAYWRIGHT_BROWSERS_PATH=0 node scripts/smoke.js",
    "smoke:mongo": "node scripts/smoke.js mongo",
    "smoke:gemini": "node scripts/smoke.js gemini",
    "smoke:browser": "PLAYWRIGHT_BROWSERS_PATH=0 node scripts/smoke.js browser",
    "smoke:graph": "node scripts/smoke.js graph",
    "evals": "node evals/run-evals.js",
    "install:chromium": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9"
  },
  "dependencies": {
    "@langchain/core": "^1.2.16",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/langgraph": "^1.4.19",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "ejs": "^7.0.1",
    "express": "^5.2.1",
    "mongoose": "^9.1.4",
    "passport": "^0.7.0",
    "playwright": "^1.63.0",
    "zod": "^4.6.5"
  }
}
