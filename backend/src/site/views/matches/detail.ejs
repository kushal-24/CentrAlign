<%- include('../partials/header') %>
<a class="back-link" href="/matches">← Back to matches</a>
<section class="event-hero"><div class="event-hero-copy"><p class="eyebrow light"><%= match.sport %> / <%= match.competition %></p><div class="badge-row"><span class="status-badge badge-<%= match.status %>"><%= match.status %></span><% if (match.bookingStatus === 'postponed') { %><span class="status-badge badge-postponed">Postponed</span><% } %><% if (match.isFree) { %><span class="status-badge badge-free">Free event</span><% } %></div><h1><%= match.title %></h1><p><%= match.city %>, <%= match.country %> · <%= match.displayTime %></p></div><%- include('../partials/sport-art', { sport: match.sport }) %></section>
<div class="detail-layout">
  <div class="detail-content"><section class="panel"><p class="eyebrow">THE MAIN EVENT</p><h2>All the match details</h2><dl class="facts-grid"><div><dt>Participants</dt><dd><%= match.participants %></dd></div><div><dt>Competition</dt><dd><%= match.competition %></dd></div><div><dt>Venue</dt><dd><%= match.venue %><small><%= match.city %>, <%= match.country %></small></dd></div><div><dt>Venue time</dt><dd><%= match.displayTime %></dd></div><div><dt>Starts</dt><dd><time datetime="<%= match.startsAt.toISOString() %>"><%= formatTime(match.startsAt) %></time></dd></div><div><dt>Ends</dt><dd><time datetime="<%= match.endsAt.toISOString() %>"><%= formatTime(match.endsAt) %></time></dd></div></dl></section><section class="panel policy-panel"><p class="eyebrow">KNOW BEFORE YOU GO</p><h2>Refund policy</h2><p class="policy-copy"><%= match.policyText %></p></section></div>
  <aside class="panel ticket-summary" aria-labelledby="ticket-options"><p class="eyebrow">YOUR PLACE IN THE CROWD</p><h2 id="ticket-options"><%= match.isFree ? 'Free entry' : formatMoney(match.price) %></h2><p class="muted"><%= match.isFree ? 'Fan-arena screening · ₹0 per ticket' : 'per ticket · one simple price' %></p><div class="availability"><span><%= match.remaining === 0 ? 'Sold out' : `${match.remaining} tickets remaining` %></span><div class="inventory-track"><span style="width: <%= Math.round(match.sold / match.capacity * 100) %>%"></span></div></div><dl class="compact-facts"><div><dt>Total seats</dt><dd><%= match.capacity %></dd></div><div><dt>Booking limit</dt><dd><%= match.perBookingLimit %> tickets</dd></div><div><dt>Bookings</dt><dd><%= match.bookingStatus === 'postponed' ? 'On hold' : match.status === 'upcoming' ? 'Open' : 'Closed' %></dd></div></dl><p class="availability-note">Booking and waitlist reservations are coming soon.</p></aside>
</div>
<%- include('../partials/footer') %>
