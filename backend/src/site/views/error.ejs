<%- include('partials/header') %>
<section class="error-panel panel"><p class="eyebrow">LET'S GET YOU BACK ON TRACK</p><span class="error-code" aria-hidden="true"><%= status %></span><h1><%= status === 404 ? 'Nothing at this address.' : status === 401 ? 'Your tickets are personal.' : status === 400 ? 'Let’s adjust that search.' : 'A short timeout.' %></h1><p class="error-message" role="alert"><%= message %></p><% if (status === 401) { %><form class="error-session" action="/session/demo" method="post"><button class="button button-dark" type="submit">Open demo session ↗</button></form><% } %><a class="button button-dark" href="/matches">Back to matches ↗</a></section>
<%- include('partials/footer') %>
