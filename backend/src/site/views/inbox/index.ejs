<%- include('../partials/header') %>
<section class="page-heading"><p class="eyebrow">EVERY DETAIL, DELIVERED</p><h1>Your matchday <em>inbox.</em></h1><p>Confirmations and updates for your plans.</p><span class="identity-chip"><span class="tiny-dot"></span><%= user.name %></span></section>
<div class="section-heading"><h2>Messages</h2><span class="count-pill"><%= messages.length %></span></div>
<section class="inbox-list" aria-label="Your messages"><% messages.forEach(message => { %><article class="message-card"><span class="message-icon" aria-hidden="true">↗</span><div class="message-content"><div class="message-meta"><span class="eyebrow"><%= message.type.replaceAll('_', ' ') %></span><time datetime="<%= message.createdAt.toISOString() %>"><%= formatTime(message.createdAt) %></time></div><h2><%= message.subject %></h2><p class="recipient">To: <%= message.to %></p><p class="message-body"><%= message.body %></p><% if (message.ticketLink) { %><a class="text-link" href="<%= message.ticketLink %>">View ticket ↗</a><% } %></div></article><% }) %><% if (!messages.length) { %><div class="empty-state"><h2>You're all caught up</h2><p>Your confirmations and updates will appear here.</p><a class="button button-dark" href="/matches">Discover matches ↗</a></div><% } %></section>
<%- include('../partials/footer') %>
