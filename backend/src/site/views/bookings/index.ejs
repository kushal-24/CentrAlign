<%- include('../partials/header') %>
<section class="page-heading"><p class="eyebrow">YOUR MATCHDAY LINEUP</p><h1>Good times, <em>booked.</em></h1><p>Your tickets and waitlist spots, all in one place.</p><span class="identity-chip"><span class="tiny-dot"></span><%= user.name %></span></section>
<section aria-labelledby="tickets-title"><div class="section-heading"><h2 id="tickets-title">My tickets</h2><span class="count-pill"><%= bookings.length %></span></div><div class="booking-grid"><% bookings.forEach(booking => { %><article class="booking-card"><div class="booking-art"><%- include('../partials/sport-art', { sport: booking.match?.sport || 'football' }) %></div><div class="booking-card-content"><div class="booking-top"><p class="eyebrow"><%= booking.code %></p><span class="status-badge badge-<%= booking.status %>"><%= booking.status === 'booked' ? 'Confirmed' : 'Cancelled' %></span></div><h3><%= booking.match?.title || 'Event unavailable' %></h3><p class="muted"><%= booking.match?.city || '' %><%= booking.match ? ` · ${booking.match.displayTime}` : '' %></p><div class="booking-bottom"><span><%= booking.quantity %> <%= booking.quantity === 1 ? 'ticket' : 'tickets' %> · <strong><%= formatMoney(booking.totalPrice) %></strong></span><a class="text-link" href="/bookings/<%= booking._id %>">View ticket ↗</a></div></div></article><% }) %></div><% if (!bookings.length) { %><div class="empty-state"><h3>Your next matchday awaits</h3><p>No tickets here yet. Find a match that catches your eye.</p><a class="button button-dark" href="/matches">Discover matches ↗</a></div><% } %></section>
<section class="waitlist-section" aria-labelledby="waitlist-title"><div class="section-heading"><div><p class="eyebrow">STAY IN THE RUNNING</p><h2 id="waitlist-title">My waitlist</h2></div><span class="count-pill"><%= waitlist.length %></span></div><% if (!waitlist.length) { %><div class="empty-state compact"><h3>No waitlist spots yet</h3><p>Your places in the queue will appear here.</p></div><% } else { %><div class="waitlist-list"><% waitlist.forEach(entry => { %><article class="panel waitlist-card"><span class="queue-position">#<%= entry.position %><small>in line</small></span><div><h3><% if (entry.match) { %><a href="/matches/<%= entry.matchId %>"><%= entry.match.title %></a><% } else { %>Event unavailable<% } %></h3><p class="muted"><%= entry.quantity %> tickets requested · Joined <time datetime="<%= entry.createdAt.toISOString() %>"><%= formatTime(entry.createdAt) %></time></p></div></article><% }) %></div><% } %></section>
<%- include('../partials/footer') %>
