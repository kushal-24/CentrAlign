<%- include('../partials/header') %>
<a class="back-link" href="/bookings">← Back to my bookings</a>
<section class="page-heading small"><p class="eyebrow">A MOMENT TO LOOK FORWARD TO</p><h1>Your matchday <em>ticket.</em></h1><p>All the details for your place in the crowd.</p></section>
<article class="ticket-page"><div class="ticket-main"><div class="ticket-heading"><a class="brand" href="/matches">matchday.</a><span class="status-badge badge-<%= booking.status %>"><%= booking.status === 'booked' ? 'Confirmed' : 'Cancelled' %></span></div><p class="eyebrow"><%= match.competition %> / <%= match.sport %></p><h2><%= match.title %></h2><p class="ticket-venue"><%= match.venue %> · <%= match.city %>, <%= match.country %></p><dl class="facts-grid"><div><dt>Venue time</dt><dd><%= match.displayTime %></dd></div><div><dt>Tickets</dt><dd><%= booking.quantity %> <%= booking.quantity === 1 ? 'person' : 'people' %></dd></div><div><dt>Booked by</dt><dd><%= booking.ownerName %><small><%= booking.ownerEmail %></small></dd></div><div><dt>Booked on</dt><dd><time datetime="<%= booking.createdAt.toISOString() %>"><%= formatTime(booking.createdAt) %></time></dd></div></dl><% if (booking.status === 'cancelled') { %><div class="refund-note" role="alert">Refund: <strong><%= formatMoney(booking.refundAmount) %></strong><% if (booking.cancelledAt) { %> · Cancelled <%= formatTime(booking.cancelledAt) %><% } %></div><% } %></div><aside class="ticket-stub"><p class="eyebrow light">BOOKING REFERENCE</p><p class="booking-code"><%= booking.code %></p><span class="stub-divider"></span><p class="eyebrow light">TOTAL PAID</p><p class="stub-price"><%= formatMoney(booking.totalPrice) %></p><p><%= booking.quantity %> <%= booking.quantity === 1 ? 'ticket' : 'tickets' %></p><a class="button button-mint" href="/matches/<%= match._id %>">View event ↗</a></aside></article>
<section class="panel policy-panel ticket-policy"><p class="eyebrow">KNOW BEFORE YOU GO</p><h2>Refund policy</h2><p><%= match.policyText %></p><p class="availability-note">Ticket cancellation will be available soon.</p></section>
<%- include('../partials/footer') %>
